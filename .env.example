# === Backend 'subscription': dung goi Claude Pro/Max, khong ton tien API ===
# Sinh bang: ./scripts/setup_token.sh  (han 1 nam, can goi Pro/Max/Team/Enterprise)
CLAUDE_CODE_OAUTH_TOKEN=

# === Backend 'api_key': tinh tien theo token ===
CLAUDE_API_KEY=
# Chi la gia tri du phong khi Supabase chua co config; model that doc tu app_config
CLAUDE_MODEL=claude-sonnet-5

# Telegram
TELEGRAM_BOT_TOKEN=
# Telegram numeric user id cua chinh chu - bot chi tra loi user nay
TELEGRAM_OWNER_ID=

# Supabase (cloud project - Settings > API)
SUPABASE_URL=
SUPABASE_KEY=

# Web admin
ADMIN_USERNAME=admin
# Tao bang: python -c "from app.web.auth import hash_password; print(hash_password('your-password'))"
ADMIN_PASSWORD_HASH=
APP_SECRET_KEY=change-me-to-a-random-long-string

# Dung de ma hoa key broker luu trong Supabase (tuong lai) - tao bang:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
